  "grammar": {
    "fr": [
      [
        "(?<!\\w)([Aa])ucune(\\s+)((?:\\*\\*)?(?:<[^>]+>)*clusters?\\b)",
        "\\1ucun\\2\\3"
      ],
      [
        "(?<!\\w)([Uu])ne(\\s+)((?:\\*\\*)?(?:<[^>]+>)*clusters?\\b)",
        "\\1n\\2\\3"
      ],
      [
        "(?<!\\w)([Ll])a(\\s+)((?:\\*\\*)?(?:<[^>]+>)*clusters?\\b)",
        "\\1e\\2\\3"
      ],
      [
        "(?<!\\w)([Cc])ette(\\s+)((?:\\*\\*)?(?:<[^>]+>)*clusters?\\b)",
        "\\1e\\2\\3"
      ],
      [
        "([Aa]rchitecture) [Cc](luster)",
        "\\1 de c\\2"
      ],
      [
        "((?:adresse )?IP virtuelles?) principal/secondaire",
        "\\1 principale/secondaire"
      ],
      [
        "\\b(clusters?)\\s+(?:à\\s+)?haute disponibilité",
        "\\1 de haute disponibilité"
      ],
      [
        "\\b([Ff]onctionnement) (cluster)",
        "\\1 du \\2"
      ]
    ],
    "it": [
      [
        "(?<!\\w)([Uu])na(\\s+)((?:\\*\\*)?(?:<[^>]+>)*clusters?\\b)",
        "\\1n\\2\\3"
      ],
      [
        "(\\S) +:(?=\\s|\\*|$)",
        "\\1:"
      ],
      [
        "([Aa]rchitettura) ([Cc]luster)",
        "\\1 di \\2"
      ]
    ],
    "es": [
      [
        "(?<!\\w)([Uu])na(\\s+)((?:\\*\\*)?(?:<[^>]+>)*clústere?s?\\b)",
        "\\1n\\2\\3"
      ],
      [
        "(\\S) +:(?=\\s|\\*|$)",
        "\\1:"
      ],
      [
        "([Aa]rquitectura) ([Cc]lúster)",
        "\\1 de \\2"
      ]
    ],
    "pt": [
      [
        "(?<!\\w)([Uu])ma(\\s+)((?:\\*\\*)?(?:<[^>]+>)*clusters?\\b)",
        "\\1m\\2\\3"
      ],
      [
        "(\\S) +:(?=\\s|\\*|$)",
        "\\1:"
      ],
      [
        "([Aa]rquitetura) ([Cc]luster)",
        "\\1 de \\2"
      ]
    ],
    "ar": [
      [
        "((?:IP|اسم|بروتوكول الإنترنت)\\s+(?:\\*\\*)?(?:ال)?)افتراضي",
        "\\1ظاهري"
      ],
      [
        "(\\S*مجموعات)\\s+مجموعات(?=\\s)",
        "\\1"
      ],
      [
        "(\\S*مجموعة)\\s+مجموعة(?=\\s)",
        "\\1"
      ],
      [
        "بروتوكول (?:[\\u0600-\\u06FF]+ ){1,3}(?=\\(?GARP)",
        ""
      ],
      [
        "(\\S) +:(?=\\s)",
        "\\1:"
      ]
    ],
    "de": [
      [
        "(Cluster) +([:,.])",
        "\\1\\2"
      ],
      [
        "(Cluster) -(\\w)",
        "\\1-\\2"
      ],
      [
        "` -(\\w)",
        "`-\\1"
      ],
      [
        "(\\S) +:(?=\\s|\\*|$)",
        "\\1:"
      ],
      [
        "(\\w\\.safe) (?=(?:Modul|Cluster)\\w*)",
        "\\1-"
      ]
    ],
    "ko": [
      [
        "(클러스터|VLAN|ARP|IP|통합자|\\(PRIM\\)|\\(SECOND\\))\\s+(의|에서|에|용|를|을|은|는|이|가|과|와|으로|로|도|만)(?=[\\s.,:;)!?*]|$)",
        "\\1\\2"
      ],
      [
        "(\\*\\*)\\s+(의|에서|에|용|를|을|은|는|이|가|과|와|으로|로|도|만)(?=[\\s.,:;)!?]|$)",
        "\\1\\2"
      ],
      [
        "(\\w)/ (GARP)",
        "\\1/\\2"
      ],
      [
        "(\\S) +:(?=\\s)",
        "\\1:"
      ],
      [
        "\\*\\*([^*\\n]+?)(을|를|은|는|의)\\*\\*",
        "**\\1**\\2"
      ]
    ],
    "ja": [
      [
        "クラスタ(?![ーリ])",
        "クラスター"
      ],
      [
        "透明性",
        "透過性"
      ],
      [
        "(\\S) （",
        "\\1（"
      ],
      [
        "→\\*\\*",
        "→ **"
      ]
    ],
    "zh-hans": [
      [
        "(\\S) （",
        "\\1（"
      ],
      [
        "(\\w)/ (\\w)",
        "\\1/\\2"
      ],
      [
        "→\\*\\*",
        "→ **"
      ]
    ],
    "nl": [
      [
        "(\\S) +:(?=\\s|\\*|$)",
        "\\1:"
      ],
      [
        "-cluster\\s+cluster(\\w)",
        "-cluster\\1"
      ],
      [
        "(\\S) -(?=[a-z])",
        "\\1-"
      ]
    ]
  }
