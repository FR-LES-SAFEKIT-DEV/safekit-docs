<!DOCTYPE HTML>
<html>
<head>
    <title>SafeKit / Module Configuration</title>
    <meta content="SafeKit Module Configuration" name="title" />
    <meta content="IE=Edge" http-equiv="X-UA-Compatible" />
    <meta charset="UTF-8" />

    <script>
      
      $(function(){
	
	  // 	
	  // Additional page specific functions (integrator must write this)
	  //

	    function setRepliFlow(){
		$(userconfigXML).find("heartbeat[ident='flow']").removeAttr("ident");
		findXmlNode($(this)).attr("ident","flow");
	    }
	    
	    function showRepliFlow(){
				$("#hbTable .repliFlow").show();	

		var repliflow=($(userconfigXML).find("heartbeat[ident='flow']").length!=0);
		if (repliflow) {
		  $("#hbTable .xmlNodeRep").each(
		    function(){
			if(findXmlNode($(this)).attr("ident") == 'flow'){
			    $(this).find("input:radio[name='repliFlow']").attr("checked",true);
			}
		    });
		} else {
			$("#hbTable").find("input:radio[name='repliFlow']:first").attr("checked",true).trigger('change');
		}
		
	    }

	    function hideRepliFlow()
	    {
		if($(userconfigXML).find("rfs replicated").length == 0){
		    try{
			$(userconfigXML).find("heartbeat[ident='flow']").removeAttr("ident");	
		    } catch (x) {
		    }

		    $("#hbTable .repliFlow").hide();
		}
	    }



	    xmlRender($("#renderTargets"),$(userconfigXML));
	    
	    // Add page specific additional semantics
	    $("#renderTargets").delegate("input:radio[name='repliFlow']","change",setRepliFlow);
	    $("#renderTargets").delegate("#rfsTable .xmlNodeNewBtn[rel='service/rfs']","click",showRepliFlow);
	    $("#renderTargets").delegate("#rfsTable .xmlNodeDelBtn",'click',hideRepliFlow)
	    
	    if($(userconfigXML).find("rfs replicated").length == 0){
		$("#hbTable .repliFlow").hide();
	    }
	    else {
		showRepliFlow();
	    }
      });
      
</script>	


</head>
<body>

	<h1 lang="default" class="confTitle"> Supply Hyper-V Module Parameters </h1>
	
    <!-- Render  targets (integrator must write this) -->
    
    <div id="renderTargets">

      <div class="sectionContainer">
	<h4> Please Note:</h2>
        <p> The Hyper-v module example makes the following assumptions:</p>
        <ul>
          <li> The hypervisor is Windows 2019, Windows 2016, Windows Server 2012 R2 or Windows 8.1 Hyper-V version, and hyper-v powershell cmdlets are available.</li>
          <li> The VM_PATH\VM_NAME folder contains a single exported virtual machine, and it is registered "in place" with the hyper-v manager. <br/> 
		  To fulfill this condition, export the virtual machine to the VM_PATH folder, delete the VM VM_NAME from hyper-v manager, and re-import it from the VM_PATH\VM_NAME folder using hyper-v manager or powershell commands (or use the preparevm.ps1 script delivered with this application module).</li>
        </ul>
	<p> The NORMAL_STOP and FORCE_STOP values may be "save","stop" or "off". "save" saves the VM current state, "stop" shuts down the VM, "off" turns off the VM.
        <table rel="#macros" class="xmlTemplateExpand" id="macroTarget" />
      </div>
      
      <div id="hbTable" class="sectionContainer">
        <div class="sectionLabel" lang="default">Heartbeat Networks</div>
		<div class="sectionDesc" lang="default">For changing the networks, go back to the previous tab</div>
        <div id='hbTarget' class="xmlTemplateExpand" rel="#720hb">
        </div>
      </div>

      
      
    </div>
    
</body>
</html>
