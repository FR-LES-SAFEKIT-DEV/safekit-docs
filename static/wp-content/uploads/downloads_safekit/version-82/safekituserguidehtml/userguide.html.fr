<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Guide de l'utilisateur de SafeKit</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes">
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
    }

    .container {
      display: flex;
      height: 100vh;
      width: 100%;
    }

    .index-container {
      width: 20%;
      height: 100%;
    }

    .doc-container {
      width: 80%;
      height: 100%;
    }

    iframe {
      width: 100%;
      height: 100%;
      border: none;
    }

    @media (max-width: 860px) {
      .index-container {
        display: none;
      }

      .doc-container {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="index-container">
      <iframe id="index-frame" name="index" src="documentation/indexsafekituserguidefr.htm"></iframe>
    </div>
    <div class="doc-container">
      <iframe id="doc-frame" name="doc" src=""></iframe>
    </div>
  </div>

  <script>
    const docFrame = document.getElementById('doc-frame');

    // Charge le document avec l'ancre
    function loadDocumentWithHash() {
      const hash = window.location.hash || '#Overview';
      docFrame.src = 'documentation/safekituserguidefr.htm' + hash;
    }

    // Ajoute la meta viewport
    function enhanceFrame(frameName) {
      const frame = document.getElementById(frameName);
      frame.addEventListener('load', () => {
        const doc = frame.contentDocument || frame.contentWindow.document;

        // Ajoute la meta viewport
        const meta = doc.createElement('meta');
        meta.name = 'viewport';
        meta.content = 'width=device-width, initial-scale=1, user-scalable=yes';
        doc.head.appendChild(meta);
      });
    }

    // écoute des navigations dans les iframes sur la TOC
    function handleClickMessage(event) {
      if (event.data.type === "hashClicked") {
        console.log("Click from child :", event.data.toc);
        if(history.pushState) {
				  window.history.pushState("", "Title", window.location.href.split('#')[0] + event.data.toc);
			  }
      }
    }
    // Initialisation
    document.addEventListener('DOMContentLoaded', () => {
      loadDocumentWithHash();
      enhanceFrame('index-frame');
      enhanceFrame('doc-frame');
      window.addEventListener("message", handleClickMessage);
    });

    // Mise à jour du document si l'ancre change
    window.addEventListener('hashchange', loadDocumentWithHash);
  </script>
</body>
</html>