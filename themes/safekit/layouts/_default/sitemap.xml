{{- $realBase := .Site.Params.sitemapBaseURL | default .Site.BaseURL -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  {{ if not .Sitemap.Disable }}
  <url>
    <loc>{{ replace .Permalink $.Site.BaseURL $realBase }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ range partial "hreflang-pages.html" . }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ replace .Permalink $.Site.BaseURL $realBase }}" />{{ if eq .Language.Lang "en" }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ replace .Permalink $.Site.BaseURL $realBase }}" />{{ end }}{{ end }}
  </url>
  {{ end }}
  {{ end }}
</urlset>
