{{- $realBase := .Site.Params.sitemapBaseURL | default .Site.BaseURL -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  <url>
    <loc>{{ replace .Permalink $.Site.BaseURL $realBase }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ if .IsTranslated }}{{ range .Translations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ replace .Permalink $.Site.BaseURL $realBase }}" />{{ end }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ replace .Permalink $.Site.BaseURL $realBase }}" />{{ end }}
  </url>
  {{ end }}
</urlset>
