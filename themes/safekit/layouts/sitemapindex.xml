{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{ range . }}
  <sitemap>
    <loc>{{ .BaseURL }}{{ .Language.Lang }}/sitemap.xml</loc>
    {{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
  </sitemap>
  {{ end }}
  {{ with index . 0 }}
  <sitemap>
    <loc>{{ .BaseURL }}sitemap-documents-en.xml</loc>
  </sitemap>
  <sitemap>
    <loc>{{ .BaseURL }}sitemap-documents-fr.xml</loc>
  </sitemap>
  {{ end }}
</sitemapindex>
