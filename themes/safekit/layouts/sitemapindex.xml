{{- $realBase := (index . 0).Params.sitemapBaseURL | default (index . 0).BaseURL -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{ range . }}
  <sitemap>
    <loc>{{ $realBase }}{{ .Language.Lang }}/sitemap.xml</loc>
    {{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
  </sitemap>
  {{ end }}
  <sitemap>
    <loc>{{ $realBase }}sitemap-documents-en.xml</loc>
  </sitemap>
  <sitemap>
    <loc>{{ $realBase }}sitemap-documents-fr.xml</loc>
  </sitemap>
</sitemapindex>
